{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "frontend",
      "framework": "vite",
      "routePrefix": "/"
    },
    "api": {
      "entrypoint": "api/index.py",
      "framework": "fastapi",
      "routePrefix": "/server",
      "includeFiles": "backend/**"
    }
  }
}
